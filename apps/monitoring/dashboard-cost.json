    "k3s-lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "eur_per_kwh",
        "label": "Prix kWh (€)",
        "type": "textbox",
        "query": "0.25",
        "current": {
          "text": "0.25",
          "value": "0.25"
        }
      },
      {
        "name": "overhead_w",
        "label": "Overhead/nœud (W hors-RAPL)",
        "type": "textbox",
        "query": "8",
        "current": {
          "text": "8",
          "value": "8"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "À lire",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Kepler (RAPL) mesure le CPU + DRAM, pas la machine entière.** On ajoute un *overhead* fixe par nœud (`$overhead_w` W : carte mère, SSD, ventilos, pertes alim) pour estimer la conso **à la prise**. Ajuste `Prix kWh` et `Overhead` en haut. Un wattmètre sur prise permettrait de caler l'overhead au watt près."
      }
    },
    {
      "type": "stat",
      "title": "Puissance estimée à la prise",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(kepler_node_cpu_watts) + $overhead_w * count(kepler_node_cpu_watts{zone=\"package\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PDE6745920139CE56"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "PDE6745920139CE56"
      }
    },
    {
      "type": "stat",
      "title": "Coût / jour (projeté)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 3,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "targets": [
        {
          "expr": "(sum(kepler_node_cpu_watts) + $overhead_w * count(kepler_node_cpu_watts{zone=\"package\"})) / 1000 * 24 * $eur_per_kwh",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PDE6745920139CE56"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "PDE6745920139CE56"
      }
